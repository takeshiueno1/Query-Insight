DB_NAME=query_insight
DB_USER=query_insight
DB_PASSWORD=change-this-local-password
AUTH_SECURE_COOKIE=false
AUTH_ALLOWED_ORIGINS=http://localhost:8088
AI_ENABLED=true
AI_PROVIDER=ollama
OLLAMA_MODEL=qwen3:4b
OLLAMA_REQUEST_TIMEOUT=PT5M
# 総当たり攻撃とローカルAIのCPU枯渇を防ぐ既定値。必要時のみ運用要件に合わせて変更する。
LOGIN_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_MAX=3
AI_RATE_LIMIT_WINDOW=PT10M
AI_MAX_CONCURRENT=1
